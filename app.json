{
  "expo": {
    "name": "Triway",
    "slug": "Triway",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/TRIWAY.png",
    "userInterfaceStyle": "light",
    "scheme": "triway",
    "experiments": {
      "baseUrl": ""
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F5C2E",
          "image": "./assets/images/TRIWAY.png",
          "imageWidth": 150,
          "resizeMode": "contain"
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.triway.app",
      "adaptiveIcon": {
        "backgroundColor": "#064E3B",
        "foregroundImage": "./assets/images/TRIWAY.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/TRIWAY.png"
    }
  }
}
